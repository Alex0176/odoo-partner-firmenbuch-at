<odoo>
    <record id="view_firmenbuch_proposal_form" model="ir.ui.view">
        <field name="name">firmenbuch.proposal.form</field>
        <field name="model">firmenbuch.proposal</field>
        <field name="arch" type="xml">
            <form string="Business register proposal">
                <header>
                    <button name="action_apply" type="object" string="Apply selected" class="btn-primary"
                            invisible="state != 'pending'" groups="base.group_partner_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'" groups="base.group_partner_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,applied"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="risk != 'critical'">
                        <b>Business register: critical.</b> <field name="risk_note" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="risk != 'warning'">
                        <b>Business register: warning.</b> <field name="risk_note" class="d-inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="fnr" readonly="1" invisible="source == 'address'"/>
                        </group>
                        <group>
                            <field name="source" readonly="1"/>
                            <field name="reason" readonly="1"/>
                            <field name="create_date" string="Proposed on"/>
                            <field name="risk" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'pending'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="apply" widget="boolean_toggle"/>
                            <field name="field_label"/>
                            <field name="old_value" readonly="1"/>
                            <field name="new_display" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_firmenbuch_proposal_list" model="ir.ui.view">
        <field name="name">firmenbuch.proposal.list</field>
        <field name="model">firmenbuch.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Proposed on"/>
                <field name="partner_id"/>
                <field name="fnr"/>
                <field name="source"/>
                <field name="reason"/>
                <field name="risk" widget="badge" decoration-danger="risk == 'critical'"
                       decoration-warning="risk == 'warning'"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>

    <record id="view_firmenbuch_proposal_search" model="ir.ui.view">
        <field name="name">firmenbuch.proposal.search</field>
        <field name="model">firmenbuch.proposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="fnr"/>
                <filter name="pending" string="To review" domain="[('state', '=', 'pending')]"/>
                <filter name="new" string="New companies" domain="[('reason', '=', 'new')]"/>
                <separator/>
                <filter name="src_register" string="Business register" domain="[('source', '=', 'register')]"/>
                <filter name="src_address" string="Address register" domain="[('source', '=', 'address')]"/>
            </search>
        </field>
    </record>

    <record id="action_firmenbuch_proposal" model="ir.actions.act_window">
        <field name="name">Business register proposals</field>
        <field name="res_model">firmenbuch.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_partner_firmenbuch_risk" model="ir.actions.act_window">
        <field name="name">Register warnings</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_fb_risk_warning': 1}</field>
    </record>

    <menuitem id="menu_firmenbuch" name="Business Register" parent="contacts.menu_contacts" sequence="10"
              groups="base.group_partner_manager"/>
    <menuitem id="menu_firmenbuch_proposal" action="action_firmenbuch_proposal" parent="menu_firmenbuch" sequence="1"/>
    <menuitem id="menu_firmenbuch_risk" action="action_partner_firmenbuch_risk" parent="menu_firmenbuch" sequence="2"/>
</odoo>
