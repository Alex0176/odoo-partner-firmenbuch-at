<odoo>
    <record id="view_firmenbuch_search_wizard_form" model="ir.ui.view">
        <field name="name">firmenbuch.search.wizard.form</field>
        <field name="model">firmenbuch.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Business register search">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <label for="query"/>
                    <div class="d-flex gap-2">
                        <field name="query" class="flex-grow-1"/>
                        <field name="exact" nolabel="1" widget="boolean_toggle"/><span>exact</span>
                        <button name="action_search" type="object" string="Search" icon="fa-search" class="btn-primary"/>
                    </div>
                </group>
                <div class="text-muted mb-2" invisible="not message"><field name="message"/></div>
                <field name="result_ids" readonly="1">
                    <list create="0" delete="0">
                        <field name="fnr"/>
                        <field name="name"/>
                        <field name="seat"/>
                        <field name="legal_form"/>
                        <field name="court" optional="hide"/>
                        <button name="action_select" type="object" string="Choose" icon="fa-check" class="btn-link"/>
                    </list>
                </field>
                <footer>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
